{
    "manifest_version": 3,
    "name": "My Custom Home Screen",
    "version": "1.0",
    "description": "Customizes the default new tab page.",
    "action": {
        "default_title": "Customize homepage"
    },
    "background": {
        "service_worker": "background.js"
    },
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "permissions": [
        "storage",
        "tabs"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
