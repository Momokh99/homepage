{
  "name": "homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Customizable new tab page browser extension.",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "npm run check && wxt build && wxt build -b firefox --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "check": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}