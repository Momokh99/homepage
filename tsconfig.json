{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    ".wxt/**/*",
    "entrypoints/**/*",
    "core/**/*",
    "widgets/**/*",
    "*.ts"
  ],
  "exclude": [".output", "node_modules", "playground"]
}