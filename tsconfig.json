{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "strict": false,
    "noImplicitAny": false
  },
  "include": ["*.js", "core/**/*.js", "widgets/**/*.js"],
  "exclude": ["dist", "node_modules", "playground", "build.js"]
}